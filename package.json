{
  "name": "huan-app",
  "productName": "huan-app",
  "version": "2.2.0",
  "private": true,
  "description": "Independent modular macOS desktop application",
  "author": "huan",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "pack:arm64": "pnpm build && electron-builder --mac --arm64 --dir",
    "pack:x64": "pnpm build && electron-builder --mac --x64 --dir"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@mozilla/readability": "0.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  }
}
